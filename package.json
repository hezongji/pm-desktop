{
  "name": "pm-desktop",
  "productName": "PM桌面",
  "version": "2.1.0",
  "description": "PM 项目管理系统桌面端（开源版·本地全栈：Electron 壳 + 内嵌 Next 服务 + IM + 嵌入式 PostgreSQL，数据全在本机）",
  "main": "dist/main/index.cjs",
  "author": "hezongji",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "verify": "node scripts/verify.mjs",
    "dev": "node scripts/dev.js",
    "stage:server": "node scripts/stage-server.mjs",
    "stage:pg": "node scripts/stage-pg.mjs",
    "stage:baseline": "node scripts/stage-baseline.mjs",
    "stage:all": "node scripts/stage-pg.mjs && node scripts/stage-baseline.mjs && node scripts/stage-server.mjs",
    "dist": "node scripts/dist.mjs",
    "dist:test": "node scripts/dist.mjs --test",
    "smoke": "node scripts/smoke.mjs",
    "smoke:test": "node scripts/smoke.mjs --test",
    "icons": "python scripts/gen-icons.py"
  },
  "dependencies": {
    "@sentry/electron": "7.20.0",
    "electron-log": "5.4.4",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
